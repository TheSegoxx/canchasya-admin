# Copiar este archivo como .env y completar los valores.
# El .env NUNCA se sube a GitHub (está en .gitignore).

# "desarrollo" muestra el detalle de los errores 500; "produccion" no
APP_ENV=desarrollo

# Base de datos (XAMPP: usuario root sin contraseña)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=canchero
DB_USER=root
DB_PASS=

# Secreto para firmar los JWT: 64 caracteres aleatorios.
# Generarlo con: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=
# Duración de la sesión en segundos (604800 = 7 días)
JWT_DURACION_SEG=604800

# ID de cliente "Aplicación web" de Google Cloud Console
GOOGLE_WEB_CLIENT_ID=

# Orígenes permitidos por CORS, separados por coma (vacío = ninguno; la app Android no lo necesita)
CORS_ORIGENES=
