# Copiar este archivo como .env y completar los valores.
# El .env NUNCA se sube a GitHub (está en .gitignore).

# "desarrollo" muestra el detalle de los errores 500; "produccion" no
APP_ENV=desarrollo

# Base de datos (XAMPP: usuario root sin contraseña)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=canchasya
DB_USER=root
DB_PASS=

# Secreto para firmar los JWT: 64 caracteres aleatorios.
# Generarlo con: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=
# Duración de la sesión en segundos (604800 = 7 días)
JWT_DURACION_SEG=604800

# ID de cliente "Aplicación web" de Google Cloud Console
GOOGLE_WEB_CLIENT_ID=

# Orígenes permitidos por CORS, separados por coma (vacío = ninguno; la app Android no lo necesita)
CORS_ORIGENES=

# Mercado Pago: Access Token de la aplicación (Tus integraciones → Credenciales).
# Para probar, el de la cuenta VENDEDORA de prueba. Nunca va en la app, solo acá.
MP_ACCESS_TOKEN=

# Correo para mandar el código de "¿Olvidaste tu contraseña?" (SMTP).
# Gmail: MAIL_USUARIO = la dirección y MAIL_CLAVE = una contraseña de aplicación
# (myaccount.google.com/apppasswords; requiere la verificación en 2 pasos).
# Otro servidor (por ejemplo Brevo): completar también MAIL_HOST, MAIL_PUERTO y MAIL_REMITENTE.
# En desarrollo, si queda vacío, los correos se guardan en storage/correos.log.
MAIL_HOST=smtp.gmail.com
MAIL_PUERTO=587
MAIL_USUARIO=
MAIL_CLAVE=
MAIL_REMITENTE=
