{
    "name": "canchasya/api",
    "description": "API REST de CanchasYa Admin: gestión de canchas, turnos y cobros para dueños de complejos",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "firebase/php-jwt": "^7.2",
        "phpmailer/phpmailer": "6.9",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "files": [
            "src/helpers.php",
            "src/Middleware/auth.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
